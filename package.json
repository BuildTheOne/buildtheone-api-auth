    "express": "^5.2.1",
    "handlebars": "^4.7.9",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.3.0",
    "nodemailer": "^9.1.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
